{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChangelogSchema",
  "type": "object",
  "required": ["versionName", "versionCode", "versions"],
  "properties": {
    "versionName": {
      "type": "string",
      "description": "The current global release version name (e.g., '1.0.1')"
    },
    "versionCode": {
      "type": "integer",
      "minimum": 1,
      "description": "The current global build sequence number for app stores"
    },
    "versions": {
      "type": "array",
      "description": "List of historical version logs",
      "items": {
        "type": "object",
        "required": ["version", "versionCode", "date", "logs"],
        "properties": {
          "version": { "type": "string" },
          "versionCode": { "type": "integer", "minimum": 1 },
          "date": { 
            "type": "string", 
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Date formatted as YYYY-MM-DD"
          },
          "logs": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}